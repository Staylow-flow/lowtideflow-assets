{"siteId": "6789f449bbb1a21245706751", "pageId": "6a59f0368e92a3bd60940ad9", "context": "Updating order form and artwork row HTML after calculator recursion fix.", "actions": [{"build_label": "artwork row", "parent_element_id": {"component": "6a59f0368e92a3bd60940ad9", "element": "373ad801-887c-2401-deaf-55b1745e2b4e"}, "creation_position": "after", "html": "<div class=\"iq-artwork-row\" id=\"iq-artwork-row\">\n  <div class=\"iq-apparel-label-spacer\" aria-hidden=\"true\"></div>\n  <div class=\"iq-artwork-actions\">\n    <button type=\"button\" class=\"iq-artwork-btn iq-apparel-label-box\" id=\"iq-artwork-upload-btn\">\n      Upload My Artwork\n    </button>\n    <button type=\"button\" class=\"iq-artwork-info-link iq-apparel-label-box\" id=\"iq-artwork-info-trigger\" aria-haspopup=\"dialog\" aria-controls=\"iq-artwork-modal\">\n      <span class=\"iq-artwork-info-icon\" aria-hidden=\"true\">i</span>\n      How does artwork pricing work?\n    </button>\n  </div>\n</div>"}, {"build_label": "order form", "parent_element_id": {"component": "6a59f0368e92a3bd60940ad9", "element": "621e5ca4-cdb0-8555-1af8-312ce2a2fed0"}, "creation_position": "after", "html": "<section class=\"iq-order-section\" id=\"iq-order-section\">\n  <h2 class=\"iq-order-heading\">Lock In Your Quote &amp; Start Your Project</h2>\n  <p class=\"iq-order-lead\">Your calculator settings travel with this brief&mdash;no re-entering numbers. We&rsquo;ll confirm artwork, timeline, and final pricing before production starts.</p>\n\n  <form class=\"iq-form\" id=\"iq-order-form\" novalidate>\n    <div class=\"iq-form-quote-hidden\" aria-hidden=\"true\">\n      <input type=\"hidden\" id=\"iq-form-quote-quantity\" name=\"quoteQuantity\" value=\"\">\n      <input type=\"hidden\" id=\"iq-form-quote-styles\" name=\"quoteStyles\" value=\"\">\n      <input type=\"hidden\" id=\"iq-form-quote-quality\" name=\"quoteQuality\" value=\"\">\n      <input type=\"hidden\" id=\"iq-form-quote-ink\" name=\"quoteInkColors\" value=\"\">\n      <input type=\"hidden\" id=\"iq-form-quote-locations\" name=\"quotePrintLocations\" value=\"\">\n      <input type=\"hidden\" id=\"iq-form-quote-total\" name=\"quoteTotalEstimate\" value=\"\">\n      <input type=\"hidden\" id=\"iq-form-hidden-payload\" name=\"quotePayload\" value=\"\">\n    </div>\n\n    <fieldset class=\"iq-form-fieldset\">\n      <legend class=\"iq-form-legend\">Contact Info</legend>\n      <div class=\"iq-form-grid iq-form-grid--2\">\n        <label class=\"iq-form-field\">\n          <span class=\"iq-form-label\">Full Name <span class=\"iq-form-required\">*</span></span>\n          <input class=\"iq-form-input\" type=\"text\" id=\"iq-form-full-name\" name=\"fullName\" autocomplete=\"name\" required>\n        </label>\n        <label class=\"iq-form-field\">\n          <span class=\"iq-form-label\">Company Name</span>\n          <input class=\"iq-form-input\" type=\"text\" id=\"iq-form-company\" name=\"companyName\" autocomplete=\"organization\">\n        </label>\n        <label class=\"iq-form-field\">\n          <span class=\"iq-form-label\">Email Address <span class=\"iq-form-required\">*</span></span>\n          <input class=\"iq-form-input\" type=\"email\" id=\"iq-form-email\" name=\"email\" autocomplete=\"email\" required>\n        </label>\n        <label class=\"iq-form-field\">\n          <span class=\"iq-form-label\">Phone Number</span>\n          <input class=\"iq-form-input\" type=\"tel\" id=\"iq-form-phone\" name=\"phone\" autocomplete=\"tel\">\n        </label>\n      </div>\n    </fieldset>\n\n    <fieldset class=\"iq-form-fieldset\">\n      <legend class=\"iq-form-legend\">Artwork Files</legend>\n      <div class=\"iq-form-upload\" id=\"iq-form-artwork-drop\">\n        <input class=\"iq-form-upload-input\" type=\"file\" id=\"iq-form-artwork-file\" name=\"artworkFiles\" accept=\".ai,.eps,.pdf,.svg,.png,.jpg,.jpeg,.tif,.tiff,.psd\" multiple aria-describedby=\"iq-form-upload-hint\">\n        <div class=\"iq-form-upload-inner\">\n          <p class=\"iq-form-upload-title\">Drag &amp; drop vector or high-res files here</p>\n          <p class=\"iq-form-upload-hint\" id=\"iq-form-upload-hint\">Accepted: .AI, .EPS, .PDF, .SVG, .PNG, .JPG, .TIFF, .PSD</p>\n          <button type=\"button\" class=\"iq-form-upload-btn\" id=\"iq-form-artwork-browse\">Browse Files</button>\n          <ul class=\"iq-form-upload-list\" id=\"iq-form-artwork-list\" hidden></ul>\n        </div>\n      </div>\n    </fieldset>\n\n    <fieldset class=\"iq-form-fieldset\">\n      <legend class=\"iq-form-legend\">Project Notes</legend>\n      <label class=\"iq-form-field\">\n        <span class=\"iq-form-label\">Deadlines, sizing, color calls, or creative direction</span>\n        <textarea class=\"iq-form-textarea\" id=\"iq-form-notes\" name=\"projectNotes\" rows=\"5\" placeholder=\"Example: Need delivery by March 15. Mix of M/L/XL. PMS 186 red on front chest only.\"></textarea>\n      </label>\n    </fieldset>\n\n    <div class=\"iq-form-actions\">\n      <button type=\"submit\" class=\"iq-form-submit\" id=\"iq-form-submit\">Submit Project Brief</button>\n      <p class=\"iq-form-status\" id=\"iq-form-status\" role=\"status\" aria-live=\"polite\"></p>\n    </div>\n  </form>\n</section>"}]}