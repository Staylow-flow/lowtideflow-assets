pe, clipped to the navy plate. */\n  .ltf-card::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    border-radius: inherit;\n    background:\n      radial-gradient(ellipse at 22% 18%, rgba(112, 64, 192, 0.72) 0%, transparent 52%),\n      radial-gradient(ellipse at 82% 28%, rgba(42, 170, 184, 0.62) 0%, transparent 50%),\n      radial-gradient(ellipse at 48% 92%, rgba(11, 128, 80, 0.58) 0%, transparent 55%),\n      radial-gradient(ellipse at 70% 70%, rgba(31, 119, 129, 0.4) 0%, transparent 48%);\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity 0.45s ease;\n  }\n\n  .ltf-card:hover::before,\n  .ltf-card.is-glow::before {\n    opacity: 0.84;\n  }\n\n  .ltf-card > * {\n    position: relative;\n    z-index: 1;\n  }\n\n  /* Spinning ring sits OUTSIDE the navy plate. */\n  .ltf-card::after {\n    content: '';\n    position: absolute;\n    inset: -6px;\n    z-index: 2;\n    border-radius: 18px;\n    padding: 3px;\n    background: conic-gradient(\n      from var(--ltf-edge-angle),\n      #4D259D, #2AAAB8, #1F7781, #0B8050, #7040C0, #4D259D\n    );\n    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);\n    -webkit-mask-composite: xor;\n    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);\n    mask-composite: exclude;\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity 0.35s ease;\n  }\n\n  .ltf-card:hover,\n  .ltf-card.is-glow {\n    border-color: transparent !important;\n  }\n\n  .ltf-card:hover::after,\n  .ltf-card.is-glow::after {\n    opacity: 1;\n    animation: ltf-edge-spin 4s linear infinite;\n  }\n\n  @media (max-width: 991px) {\n    .ltf-card.is-glow,\n    .ltf-card:hover {\n      transform: none;\n    }\n  }\n\n  /* Equip Your Crew, Beyond, Instant Quote — navy fill, 2px white ring\n     (wrap background). Hover: white drops, gradient ::before + JS pulse. */\n  .ltf-hero-bottom-bar .ltf-btn-gradient-wrap,\n  .ltf-section-cta .ltf-btn-gradient-wrap,\n  .ltf-funnel-cta .ltf-btn-gradient-wrap {\n    background: #FFFFFF;\n  }\n\n  .ltf-hero-bottom-bar .ltf-btn-gradient-wrap:hover,\n  .ltf-hero-bottom-bar .ltf-btn-gradient-wrap:focus-within,\n  .ltf-hero-bottom-bar .ltf-btn-gradient-wrap.ltf-btn-gradient-active,\n  .ltf-section-cta .ltf-btn-gradient-wrap:hover,\n  .ltf-section-cta .ltf-btn-gradient-wrap:focus-within,\n  .ltf-section-cta .ltf-btn-gradient-wrap.ltf-btn-gradient-active,\n  .ltf-funnel-cta .ltf-btn-gradient-wrap:hover,\n  .ltf-funnel-cta .ltf-btn-gradient-wrap:focus-within,\n  .ltf-funnel-cta .ltf-btn-gradient-wrap.ltf-btn-gradient-active {\n    background: transparent;\n  }\n\n  .ltf-hero-bottom-bar .ltf-btn-primary,\n  .ltf-section-cta .ltf-btn-primary,\n  .ltf-funnel-cta .ltf-btn-primary {\n    border: none !important;\n    border-radius: 10px !important;\n    background: #00001C !important;\n    background-color: #00001C !important;\n    color: #E5E5E5 !important;\n  }\n\n  /* The Crew heading — Designer combo is flex-direction: row + max-width 720,\n     which hides the center alignment already set in the Style panel. */\n  .ltf-stack.ltf-section-head,\n  .ltf-section-head {\n    display: flex !important;\n    flex-direction: column !important;\n    align-items: center !important;\n    justify-content: center !important;\n    text-align: center !important;\n    width: 100% !important;\n    max-width: none !important;\n    margin-left: auto !important;\n    margin-right: auto !important;\n  }\n\n  .ltf-section-head .ltf-section-header,\n  .ltf-section-head .ltf-section-header-navy,\n  .ltf-section-head .ltf-authority-sublabel,\n  .ltf-section-head .ltf-subheading {\n    text-align: center !important;\n    width: 100%;\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  /* ── Launch CTA: iridescent bloom on hover ──────────────────────────── */\n  .ltf-funnel-cta {\n    position: relative;\n    isolation: isolate;\n  }\n\n  .ltf-funnel-cta::before {\n    content: '';\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    z-index: 0;\n    width: 900px;\n    height: 520px;\n    max-width: 140%;\n    transform: translate(-50%, -50%);\n    background: radial-gradient(\n      ellipse at center,\n      #7040C0 0%, #4D259D 28%, #1F7781 52%, #0B8050 68%, transparent 78%\n    );\n    filter: blur(110px);\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity 0.55s ease;\n  }\n\n  .ltf-funnel-cta:hover::before {\n    opacity: 0.26;\n  }\n\n  .ltf-funnel-cta-inner {\n    z-index: 2;\n    transition: border-color 0.45s ease;\n  }\n\n  .ltf-funnel-cta:hover .ltf-funnel-cta-inner {\n    border-color: rgba(42, 170, 184, 0.55);\n  }\n\n  /* CTA ring: outer 12px, inner 10px — 2px gap, inner a touch tighter so\n     the white outline and navy fill share one curve. Nav stays 5px. */\n  .ltf-hero-bottom-bar .ltf-btn-gradient-wrap,\n  .ltf-section-cta .ltf-btn-gradient-wrap,\n  .ltf-funnel-cta .ltf-btn-gradient-wrap {\n    --ltf-ring-gap: 2px;\n    --ltf-btn-radius: 10px;\n    padding: var(--ltf-ring-gap);\n    border-radius: 12px;\n  }\n\n  .ltf-nav-actions .ltf-btn-gradient-wrap,\n  .ltf-nav-mobile-panel .ltf-btn-gradient-wrap {\n    --ltf-btn-radius: 5px;\n    border-radius: 5px;\n  }\n\n  /* ── Mobile / tablet: stack the new sections, scale type, kill overflow ─ */\n  @media (max-width: 991px) {\n    .ltf-main-header,\n    .hero-h1 {\n      font-size: clamp(34px, 10.5vw, 48px) !important;\n      line-height: 0.95;\n    }\n\n    .ltf-section-header,\n    .ltf-section-header-navy,\n    .ltf-funnel-cta-heading {\n      font-size: clamp(32px, 9vw, 44px) !important;\n      line-height: 0.95;\n      max-width: none !important;\n    }\n\n    .ltf-split-copy .ltf-section-header-navy {\n      max-width: none !important;\n    }\n\n    .ltf-body-text,\n    .ltf-body-text-navy {\n      width: 100% !important;\n      max-width: 100% !important;\n      height: auto !important;\n      font-size: 16px !important;\n      line-height: 1.45;\n      text-align: left;\n    }\n\n    .ltf-hero-bottom-bar,\n    .ltf-hero-bottom-bar.ltf-split-2 {\n      display: grid !important;\n      grid-template-columns: minmax(0, 1fr) !important;\n      grid-template-rows: auto !important;\n      gap: 20px !important;\n      width: 100% !important;\n      max-width: 100% !important;\n      min-width: 0 !important;\n      left: 0 !important;\n      right: 0 !important;\n      bottom: 24px !important;\n      transform: none !important;\n      padding-left: 0;\n      padding-right: 0;\n      box-sizing: border-box;\n    }\n\n    .ltf-hero-bottom-bar .ltf-split-copy,\n    .ltf-hero-bottom-bar .ltf-split-asset,\n    .ltf-hero-bottom-bar .is-hero-copy {\n      width: 100% !important;\n      max-width: 100% !important;\n      padding-left: 0 !important;\n      padding-right: 0 !important;\n    }\n\n    .ltf-split-2,\n    .ltf-split-2.ltf-split,\n    .ltf-upsell-grid.ltf-split-2,\n    .ltf-vault-cage.ltf-split-2 {\n      display: grid !important;\n      grid-template-columns: minmax(0, 1fr) !important;\n      gap: 28px !important;\n    }\n\n    .ltf-split-copy:not(.is-hero-copy),\n    .ltf-split-asset:not(.ltf-upsell-list) {\n      padding-left: 0 !important;\n      padding-right: 0 !important;\n      width: 100% !important;\n      max-width: 100% !important;\n    }\n\n    .ltf-specs-vault,\n    .ltf-specs-vault-sticky,\n    [data-ltf-specs-slam] {\n      height: auto !important;\n      min-height: 0 !important;\n      max-height: none !important;\n      position: relative !important;\n    }\n\n    .ltf-specs-vault-cards {\n      display: flex !important;\n      flex-direction: column !important;\n      gap: 16px !important;\n      width: 100% !important;\n      max-width: 100% !important;\n      flex: 0 1 auto !important;\n      height: auto !important;\n      min-height: 0 !important;\n      overflow: visible !important;\n      padding-bottom: 0;\n    }\n\n    .ltf-spec-card,\n    .ltf-spec-card.ltf-spec-card-01,\n    .ltf-spec-card.ltf-spec-card-02,\n    .ltf-spec-card.ltf-spec-card-03,\n    .ltf-spec-card.ltf-spec-card-04 {\n      position: relative !important;\n      top: 0 !important;\n      left: 0 !important;\n      width: 100% !important;\n      max-width: 100% !important;\n      height: auto !important;\n      min-height: 0 !important;\n      max-height: none !important;\n      padding: 28px 24px !important;\n    }\n\n    .ltf-upsell-list-item {\n      font-size: 16px !important;\n      line-height: 1.35;\n      padding: 16px 16px 16px 14px !important;\n    }\n\n    .ltf-cards-grid {\n      grid-template-columns: minmax(0, 1fr) !important;\n      gap: 16px !important;\n    }\n\n    .ltf-card {\n      width: 100% !important;\n      will-change: auto;\n      min-height: 0;\n    }\n\n    .ltf-funnel-cta::before {\n      width: 140%;\n      height: 280px;\n      filter: blur(70px);\n    }\n\n    .ltf-hero-headline {\n      padding-left: 0 !important;\n      padding-right: 0 !important;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .ltf-card:hover::after { animation: none; }\n    .ltf-authority-image-box,\n    .ltf-magnifier { cursor: auto; }\n    .ltf-magnifier-lens { opacity: 1; }\n    .ltf-card { transform: none !important; transition: none !important; }\n    .ltf-upsell-list-item:hover::after,\n    .ltf-upsell-list-item.is-sweep::after { animation: none; }\n  }\n</style>\n"}}],"context":"Push Clean-slate head with larger mobile nav button type matching panel links."}