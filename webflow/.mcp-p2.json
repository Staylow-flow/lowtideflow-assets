align-items: flex-start;\n      gap: 24px;\n      width: 100%;\n      margin: 0 0 28px;\n      padding: 0;\n      flex-shrink: 0;\n    }\n\n    .ltf-nav-mobile-panel .ltf-nav-link {\n      font-size: 19px;\n      letter-spacing: 0.14em;\n    }\n\n    .ltf-nav-mobile-panel .ltf-nav-actions {\n      flex-direction: column;\n      align-items: stretch;\n      width: 100%;\n      height: auto;\n      gap: 12px;\n      margin: 0;\n      padding-top: 8px;\n      border-top: 1px solid rgba(255, 255, 255, 0.1);\n      flex-shrink: 0;\n    }\n\n    .ltf-nav-mobile-panel .ltf-btn-gradient-wrap {\n      display: block;\n      width: 100%;\n    }\n\n    .ltf-nav-mobile-panel .ltf-nav-btn,\n    .ltf-nav-mobile-panel .ltf-nav-btn-quote {\n      width: 100%;\n      justify-content: center;\n      text-align: center;\n      font-size: 19px;\n      letter-spacing: 0.14em;\n      padding-top: 14px;\n      padding-bottom: 14px;\n      padding-left: 20px;\n      padding-right: 20px;\n    }\n  }\n\n  /* ════════════════════════════════════════════════════════════════════\n     LAYOUT  — cage and even insets. Hero bar width lives in Designer.\n     ════════════════════════════════════════════════════════════════════ */\n  .ltf-section:has(.ltf-split-2):not(.ltf-upsell):not(:has(.ltf-authority-image-box)),\n  .ltf-section:has(.ltf-cards-grid),\n  .ltf-specs-vault {\n    padding-left: 0;\n    padding-right: 0;\n    padding-top: var(--ltf-section-pad-y);\n    padding-bottom: var(--ltf-section-pad-y);\n  }\n\n  /* Beyond the Gear — padding lives in Designer (.ltf-upsell is 120).\n     List sits on the CTA baseline: grid align-end, no extra top margin. */\n  .ltf-upsell-grid.ltf-split-2 {\n    align-items: end;\n  }\n\n  .ltf-upsell-list.ltf-split-asset {\n    margin-top: 0;\n    align-self: end;\n  }\n\n  .ltf-cage {\n    box-sizing: border-box;\n    width: 100%;\n    max-width: var(--site-max-width);\n    margin-left: auto;\n    margin-right: auto;\n    padding-left: var(--ltf-side-pad);\n    padding-right: var(--ltf-side-pad);\n  }\n\n  .ltf-split-2:not(.ltf-hero-bottom-bar):not(.ltf-upsell-grid) {\n    display: grid;\n    align-items: start;\n    width: 100%;\n  }\n\n  /* Outer 40px (edge) + inner 50px (gutter) on BOTH columns.\n     Hero left copy uses .is-hero-copy in Designer — do not touch it here. */\n  .ltf-split-copy:not(.is-hero-copy) {\n    box-sizing: border-box;\n    min-width: 0;\n    padding-left: var(--ltf-split-inset);\n    padding-right: var(--ltf-split-inner);\n  }\n\n  .ltf-split-asset:not(.ltf-upsell-list) {\n    box-sizing: border-box;\n    min-width: 0;\n    padding-left: var(--ltf-split-inner);\n    padding-right: var(--ltf-split-inset);\n  }\n\n  /* Force SPECs & / STANDARDS onto two lines at the 1400 cage. */\n  .ltf-split-copy .ltf-section-header-navy {\n    max-width: 6.4em !important;\n  }\n\n  /* Beyond the Gear list position lives in Designer (.ltf-upsell-list.ltf-split-asset). */\n\n  /* Force SPECs & / STANDARDS onto two lines. */\n  .ltf-split-copy .ltf-section-header-navy {\n    max-width: 6.4em;\n  }\n\n  /* ── Specs vault cards ──────────────────────────────────────────────── */\n  .ltf-specs-vault-cards {\n    flex: 0 0 auto !important;\n  }\n\n  .ltf-spec-card,\n  .ltf-spec-card.ltf-spec-card-01,\n  .ltf-spec-card.ltf-spec-card-02,\n  .ltf-spec-card.ltf-spec-card-03,\n  .ltf-spec-card.ltf-spec-card-04 {\n    width: 460px;\n    max-width: 460px;\n    height: 340px;\n    min-height: 340px;\n    max-height: 340px;\n    padding-left: 64px;\n    padding-right: 64px;\n  }\n\n  .ltf-spec-card.ltf-spec-card-02 { top: 12px; left: 12px; }\n  .ltf-spec-card.ltf-spec-card-03 { top: 24px; left: 24px; }\n  .ltf-spec-card.ltf-spec-card-04 { top: 36px; left: 36px; }\n\n  /* ── Beyond the Gear: fill the Q3 column, sweep on hover ────────────── */\n  @keyframes ltf-upsell-sweep {\n    from { background-position: 100% 50%; }\n    to   { background-position: 0% 50%; }\n  }\n\n  /* Sweep clips to the 12px rounded list border. */\n  .ltf-upsell-list,\n  .ltf-upsell-list.ltf-split-asset {\n    max-width: 100%;\n    width: 100%;\n    padding: 0;\n    overflow: hidden;\n    border-radius: 12px;\n    box-sizing: border-box;\n  }\n\n  .ltf-upsell-list-item {\n    position: relative;\n    display: flex;\n    align-items: flex-start;\n    line-height: 1.3;\n    padding: 22px 28px 22px 24px;\n    background-color: transparent !important;\n    color: #FFFFFF !important;\n    isolation: isolate;\n    overflow: hidden;\n    transition: color 0.3s ease, border-color 0.3s ease;\n  }\n\n  .ltf-upsell-list-item > * {\n    position: relative;\n    z-index: 2;\n  }\n\n  .ltf-upsell-list-item::before {\n    content: '▪';\n    color: #2AAAB8;\n    font-size: 11px;\n    line-height: 1.7;\n    flex-shrink: 0;\n    margin-right: 14px;\n    position: relative;\n    z-index: 2;\n  }\n\n  /* Quiet purple → green → teal loop behind the white type. No fill plate. */\n  .ltf-upsell-list-item::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    z-index: -1;\n    background: linear-gradient(\n      90deg,\n      transparent 0%,\n      rgba(112, 64, 192, 0.28) 32%,\n      rgba(11, 128, 80, 0.22) 46%,\n      rgba(42, 170, 184, 0.30) 52%,\n      rgba(112, 64, 192, 0.28) 68%,\n      transparent 100%\n    );\n    background-size: 220% 100%;\n    background-position: 100% 50%;\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity 0.35s ease;\n  }\n\n  .ltf-upsell-list-item:hover,\n  .ltf-upsell-list-item.is-sweep {\n    color: #FFFFFF !important;\n  }\n\n  .ltf-upsell-list-item:hover::after,\n  .ltf-upsell-list-item.is-sweep::after {\n    opacity: 1;\n    animation: ltf-upsell-sweep 3.4s linear infinite;\n  }\n\n  .ltf-upsell-list-item:hover::before,\n  .ltf-upsell-list-item.is-sweep::before {\n    color: #7040C0;\n  }\n\n  /* ── Trenches: one viewport tall, 20px air, glass may hang past the knit ── */\n  .ltf-section:has(.ltf-authority-image-box) {\n    height: 100vh !important;\n    min-height: 100vh !important;\n    max-height: 100vh !important;\n    box-sizing: border-box;\n    padding-top: 20px !important;\n    padding-bottom: 20px !important;\n    overflow: visible;\n    display: flex;\n    align-items: center;\n  }\n\n  .ltf-section:has(.ltf-authority-image-box) .ltf-site-cage,\n  .ltf-section:has(.ltf-authority-image-box) .ltf-section-inner,\n  .ltf-section:has(.ltf-authority-image-box) .ltf-split-2,\n  .ltf-section:has(.ltf-authority-image-box) .ltf-split-asset {\n    height: 100%;\n    overflow: visible;\n  }\n\n  .ltf-section:has(.ltf-authority-image-box) .ltf-split-2 {\n    align-items: center;\n  }\n\n  .ltf-authority-image-box,\n  .ltf-magnifier {\n    position: relative;\n    width: 100%;\n    height: calc((100vh - 40px) * 0.85) !important;\n    max-height: calc((100vh - 40px) * 0.85) !important;\n    overflow: visible !important;\n    aspect-ratio: auto !important;\n    border-radius: 0;\n    background: none;\n    border: none;\n    cursor: none;\n  }\n\n  .ltf-authority-image-box > img,\n  .ltf-magnifier-base {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    border-radius: 24px;\n  }\n\n  .ltf-magnifier:not(.is-lit) .ltf-magnifier-lens {\n    opacity: 0;\n  }\n\n  .ltf-magnifier-lens {\n    position: absolute;\n    top: 0;\n    left: 0;\n    z-index: 2;\n    pointer-events: none;\n    opacity: 1;\n    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.45));\n  }\n\n  .ltf-magnifier-hole {\n    position: absolute;\n    overflow: hidden;\n    border-radius: 50%;\n    isolation: isolate;\n    -webkit-mask-image: radial-gradient(circle, #000 68%, transparent 78%);\n    mask-image: radial-gradient(circle, #000 68%, transparent 78%);\n  }\n\n  .ltf-magnifier-print {\n    position: absolute;\n    top: 0;\n    left: 0;\n    max-width: none;\n    object-fit: cover;\n    pointer-events: none;\n  }\n\n  .ltf-magnifier-glass {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    pointer-events: none;\n    z-index: 3;\n  }\n\n  @media (max-width: 991px) {\n    .ltf-section:has(.ltf-authority-image-box) {\n      height: auto !important;\n      min-height: 0 !important;\n      max-height: none !important;\n      display: block;\n      padding-top: 48px !important;\n      padding-bottom: 48px !important;\n    }\n\n    .ltf-authority-image-box,\n    .ltf-magnifier {\n      display: block;\n      width: 100% !important;\n      height: auto !important;\n      max-height: min(70dvh, 520px) !important;\n      min-height: 0 !important;\n      aspect-ratio: 3 / 4;\n      cursor: auto;\n    }\n  }\n\n  /* ── The Crew: cards track window scroll, dock before they center ───── */\n  @property --ltf-edge-angle {\n    syntax: '<angle>';\n    initial-value: 0deg;\n    inherits: false;\n  }\n\n  @keyframes ltf-edge-spin {\n    to { --ltf-edge-angle: 360deg; }\n  }\n\n  /* The Crew — Specs grey field, navy type. Cards stay dark navy. */\n  .ltf-section:has(.ltf-cards-grid) {\n    background-color: #F0F0F0;\n    overflow-x: clip;\n    overflow-y: visible;\n  }\n\n  .ltf-section:has(.ltf-cards-grid) .ltf-section-header {\n    color: #06142E;\n  }\n\n  .ltf-cards-grid {\n    overflow: visible;\n  }\n\n  .ltf-cards-grid {\n    gap: 40px;\n  }\n\n  @media (min-width: 992px) {\n    .ltf-cards-grid {\n      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n    }\n\n    .ltf-card {\n      width: calc(75% + 25px);\n    }\n\n    /* Dock toward the 40px column gap — keep the square, don't stretch. */\n    .ltf-card:nth-child(odd) {\n      justify-self: end;\n    }\n\n    .ltf-card:nth-child(even) {\n      justify-self: start;\n    }\n  }\n\n  .ltf-card {\n    position: relative;\n    min-height: clamp(236px, 19.5vw, 332px);\n    overflow: visible;\n    isolation: isolate;\n    will-change: transform;\n    transform-origin: center center;\n    background-color: #00001C;\n    transition: border-color 0.45s ease;\n  }\n\n  /* Inner wash — behind the ty