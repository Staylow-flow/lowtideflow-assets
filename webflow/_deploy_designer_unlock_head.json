{"actions": [{"label": "designer-unlock-hero", "set_page_freeform_code": {"page_id": "6a5711c9136987eae97760e3", "location": "head", "content": "<style id=\"ltf-clean-slate-fx\">\n/* FX only \u2014 layout lives in Webflow Designer. Do not add size/pad/align here.\n   Nav-specific FX/layout (hamburger morph, hide-on-scroll, nav link/button\n   hover gradient, desktop 2-row collapse, mobile nav bar + panel) moved to\n   the site-wide head (#ltf-site-nav-fx) so every page gets it \u2014 do not\n   re-add nav rules here. */\n\n@keyframes ltf-upsell-sweep {\n  /*\n    Seamless L\u2192R loop: background-size is 300% (one full tile = 3x the\n    item's width) and background-position percentages move the image by\n    (container - bgSize) * pos/100 = -2x-item-width * pos/100. Animating\n    all the way to 150% therefore shifts by exactly one full 3x-width tile\n    (-3x-item-width), so the frame at 150% is pixel-identical to the frame\n    at 0% \u2014 the loop restart is invisible instead of jump-cutting 1/3 short.\n  */\n  from { background-position: 150% 50%; }\n  to { background-position: 0% 50%; }\n}\n\n@property --ltf-edge-angle {\n  syntax: '<angle>';\n  initial-value: 0deg;\n  inherits: false;\n}\n\n@keyframes ltf-edge-spin {\n  to { --ltf-edge-angle: 360deg; }\n}\n\n/* Page CTAs \u2014 2px white outline; hover swaps to gradient ring (same size) */\n.ltf-hero-bottom-bar .ltf-btn-gradient-wrap,\n.ltf-section-cta .ltf-btn-gradient-wrap,\n.ltf-funnel-cta .ltf-btn-gradient-wrap {\n  padding: 2px !important;\n  border-radius: 12px;\n  background: #FFFFFF !important;\n  box-shadow: none !important;\n}\n.ltf-hero-bottom-bar .ltf-btn-gradient-wrap:hover,\n.ltf-hero-bottom-bar .ltf-btn-gradient-wrap:focus-within,\n.ltf-hero-bottom-bar .ltf-btn-gradient-wrap.ltf-btn-gradient-active,\n.ltf-section-cta .ltf-btn-gradient-wrap:hover,\n.ltf-section-cta .ltf-btn-gradient-wrap:focus-within,\n.ltf-section-cta .ltf-btn-gradient-wrap.ltf-btn-gradient-active,\n.ltf-funnel-cta .ltf-btn-gradient-wrap:hover,\n.ltf-funnel-cta .ltf-btn-gradient-wrap:focus-within,\n.ltf-funnel-cta .ltf-btn-gradient-wrap.ltf-btn-gradient-active {\n  padding: 2px !important;\n  background: transparent !important;\n  box-shadow: none !important;\n}\n.ltf-hero-bottom-bar .ltf-btn-primary,\n.ltf-section-cta .ltf-btn-primary,\n.ltf-funnel-cta .ltf-btn-primary {\n  border: none !important;\n  border-radius: 10px !important;\n  background: #00001C !important;\n  color: #E5E5E5 !important;\n}\n\n/* \u2500\u2500 Crew + Specs glow \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.ltf-card,\n.ltf-spec-card {\n  position: relative;\n  overflow: visible !important;\n  isolation: isolate;\n  /* Hold border transparent until the ring finishes fading (avoids white flash on hover out). */\n  transition: border-color 0.15s ease 0.35s;\n}\n.ltf-card::before,\n.ltf-spec-card::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  border-radius: inherit;\n  background:\n    radial-gradient(ellipse at 22% 18%, rgba(112, 64, 192, 0.72) 0%, transparent 52%),\n    radial-gradient(ellipse at 82% 28%, rgba(42, 170, 184, 0.62) 0%, transparent 50%),\n    radial-gradient(ellipse at 48% 92%, rgba(11, 128, 80, 0.58) 0%, transparent 55%),\n    radial-gradient(ellipse at 70% 70%, rgba(31, 119, 129, 0.4) 0%, transparent 48%);\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 0.45s ease;\n}\n.ltf-card:hover::before,\n.ltf-card.is-glow::before,\n.ltf-spec-card:hover::before,\n.ltf-spec-card.is-glow::before {\n  opacity: 0.84;\n}\n.ltf-card > *,\n.ltf-spec-card > * {\n  position: relative;\n  z-index: 1;\n}\n.ltf-card::after,\n.ltf-spec-card::after {\n  content: '';\n  position: absolute;\n  /* Cards have a 3px border; -3px puts this pseudo on the border box edge\n     (absolute children sit from the padding edge, so 0/inherit sits inward).\n     The old -6px/18px version floated the ring outside the card, exposing\n     page background in the gap. border-radius: inherit matches 12px exactly. */\n  inset: -3px;\n  z-index: 2;\n  border-radius: inherit;\n  /* 3px ring thickness = Designer border width \u2014 flush replacement. */\n  padding: 3px;\n  background: conic-gradient(\n    from var(--ltf-edge-angle),\n    #4D259D, #2AAAB8, #1F7781, #0B8050, #7040C0, #4D259D\n  );\n  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);\n  -webkit-mask-composite: xor;\n  mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);\n  mask-composite: exclude;\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 0.35s ease;\n}\n.ltf-card:hover,\n.ltf-card.is-glow,\n.ltf-spec-card:hover,\n.ltf-spec-card.is-glow {\n  border-color: transparent !important;\n  transition: border-color 0s;\n}\n.ltf-card:hover::after,\n.ltf-card.is-glow::after,\n.ltf-spec-card:hover::after,\n.ltf-spec-card.is-glow::after {\n  opacity: 1;\n  animation: ltf-edge-spin 4s linear infinite;\n}\n\n/* \u2500\u2500 Beyond the Gear sweep \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.ltf-upsell-list {\n  overflow: hidden;\n  border-radius: 12px;\n  isolation: isolate;\n}\n.ltf-upsell-list-item {\n  position: relative;\n  z-index: 0;\n  isolation: isolate;\n  overflow: hidden;\n  list-style: none !important;\n  /* Solid fill so sweep band sits above this, under text */\n  background-color: #00001C;\n}\n.ltf-upsell-list-item::marker {\n  content: none !important;\n  font-size: 0 !important;\n}\n.ltf-upsell-list-item:first-child {\n  border-top-left-radius: 12px;\n  border-top-right-radius: 12px;\n}\n.ltf-upsell-list-item:last-child {\n  border-bottom-left-radius: 12px;\n  border-bottom-right-radius: 12px;\n  border-bottom-width: 0 !important;\n}\n.ltf-upsell-list-item > * {\n  position: relative;\n  z-index: 2;\n}\n.ltf-upsell-list-item::before {\n  content: '\u25aa' !important;\n  color: #0B8050 !important; /* green \u2192 purple on hover / touch */\n  font-size: 14px !important;\n  line-height: 1.7;\n  flex-shrink: 0;\n  margin-right: 14px;\n  position: relative;\n  z-index: 2;\n  transition: color 0.35s ease;\n}\n/*\n  Sweep band UNDER the text. The item's actual copy is a raw text node\n  (Webflow renders `.ltf-upsell-list-item` as a `<p>` with no wrapping\n  span), and per the CSS2.1 stacking-context paint order, in-flow inline\n  text (step 5) already paints ABOVE any descendant with z-index:0 or\n  higher (step 6/7) but BELOW negative-z-index descendants (step 2) \u2014 so\n  a positive z-index here was actually putting the gradient IN FRONT of\n  the copy. z-index:-1 fixes that while `isolation: isolate` above keeps\n  it scoped to this item's own stacking context (so it still paints above\n  this item's own #00001C fill from step 1, not some page-level ancestor).\n*/\n.ltf-upsell-list-item::after {\n  content: '' !important;\n  position: absolute !important;\n  inset: 0 !important;\n  z-index: -1 !important;\n  border-radius: inherit !important;\n  background-image: linear-gradient(\n    90deg,\n    rgba(112, 64, 192, 0) 0%,\n    rgba(11, 128, 80, 0.55) 10%,\n    rgba(42, 170, 184, 0.75) 22%,\n    rgba(77, 37, 157, 0.78) 36%,\n    rgba(112, 64, 192, 0.85) 50%,\n    rgba(77, 37, 157, 0.78) 64%,\n    rgba(42, 170, 184, 0.75) 78%,\n    rgba(11, 128, 80, 0.55) 90%,\n    rgba(112, 64, 192, 0) 100%\n  ) !important;\n  background-size: 300% 100% !important;\n  /*\n    NOT !important: CSS-Cascade ranks keyframe animations BELOW author\n    !important declarations, so an !important here would permanently pin\n    the value and the `ltf-upsell-sweep` animation below could visibly\n    \"run\" (Web Animations API reports it active) while never actually\n    moving anything on screen. This plain value only sets the idle\n    (opacity:0, pre-hover) position; the animation freely overrides it.\n  */\n  background-position: 0% 50%;\n  background-repeat: repeat-x !important;\n  opacity: 0 !important;\n  pointer-events: none !important;\n  transition: opacity 0.3s ease;\n}\n.ltf-upsell-list-item:hover::after,\n.ltf-upsell-list-item.is-sweep::after,\n.ltf-upsell-list-item:active::after {\n  opacity: 1 !important;\n  animation: ltf-upsell-sweep 6s linear infinite !important;\n}\n.ltf-upsell-list-item:hover::before,\n.ltf-upsell-list-item.is-sweep::before,\n.ltf-upsell-list-item:active::before {\n  color: #7040C0 !important;\n}\n\n/* \u2500\u2500 Trenches loupe \u2014 host never clips; radius lives on fabric image only \u2500 */\n.ltf-section.is-trenches,\n.ltf-section.is-trenches .ltf-section-inner,\n.ltf-section.is-trenches .ltf-split-2,\n.ltf-authority-image-box,\n.ltf-magnifier {\n  position: relative;\n  overflow: visible !important;\n}\n.ltf-authority-image-box {\n  border-radius: 0 !important;\n  max-width: 515px; /* desktop fabric \u22121% */\n  padding-top: 50px;\n  padding-bottom: 50px;\n  box-sizing: border-box;\n}\n.ltf-authority-image-box > img,\n.ltf-magnifier-base,\n.ltf-trench-image {\n  border-radius: 24px;\n}\n.ltf-magnifier:not(.is-lit) .ltf-magnifier-lens {\n  opacity: 0;\n}\n.ltf-magnifier-lens {\n  position: absolute;\n  top: 0;\n  left: 0;\n  z-index: 5;\n  pointer-events: none;\n  filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.45));\n}\n.ltf-magnifier-hole {\n  position: absolute;\n  overflow: hidden;\n  border-radius: 50%;\n  isolation: isolate;\n  -webkit-mask-image: radial-gradient(circle, #000 68%, transparent 78%);\n  mask-image: radial-gradient(circle, #000 68%, transparent 78%);\n}\n.ltf-magnifier-print {\n  position: absolute;\n  top: 0;\n  left: 0;\n  max-width: none;\n  object-fit: cover;\n  pointer-events: none;\n}\n.ltf-magnifier-glass {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  pointer-events: none;\n  z-index: 3;\n}\n\n/* \u2500\u2500 Launch Your Fleet vignette glow \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.ltf-funnel-cta {\n  position: relative;\n  isolation: isolate;\n}\n.ltf-funnel-cta::before,\n.ltf-funnel-cta-glow {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  z-index: 0;\n  width: 900px;\n  height: 520px;\n  max-width: 140%;\n  transform: translate(-50%, -50%);\n  background:\n    radial-gradient(ellipse at 28% 32%, rgba(42, 170, 184, 0.62) 0%, transparent 52%),\n    radial-gradient(ellipse at 72% 68%, rgba(112, 64, 192, 0.55) 0%, transparent 55%),\n    radial-gradient(ellipse at center, rgba(11, 128, 80, 0.28) 0%, transparent 72%);\n  filter: blur(100px);\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 0.55s ease;\n}\n.ltf-funnel-cta::before {\n  content: '';\n}\n.ltf-funnel-cta:hover::before,\n.ltf-funnel-cta.is-glow::before,\n.ltf-funnel-cta:hover .ltf-funnel-cta-glow,\n.ltf-funnel-cta.is-glow .ltf-funnel-cta-glow {\n  opacity: 0.32;\n}\n.ltf-funnel-cta-inner {\n  position: relative;\n  z-index: 2;\n  transition: border-color 0.45s ease;\n}\n.ltf-funnel-cta:hover .ltf-funnel-cta-inner,\n.ltf-funnel-cta.is-glow .ltf-funnel-cta-inner {\n  border-color: rgba(42, 170, 184, 0.55);\n}\n\n\n/* Desktop slam stack (\u22651281) \u2014 layout via specs-vault-slam.js inline styles, not head */\n\n/* Narrow desktop (992\u20131280) \u2014 Trenches grows with content; Specs layout = Designer only */\n@media (min-width: 992px) and (max-width: 1280px) {\n  .ltf-section.is-trenches {\n    height: auto !important;\n    min-height: 0 !important;\n    max-height: none !important;\n    padding-top: 96px !important;\n    padding-bottom: 96px !important;\n    overflow: visible !important;\n  }\n  .ltf-section.is-trenches .ltf-section-inner.ltf-cage {\n    padding-left: clamp(2rem, 4vw, 5rem) !important;\n    padding-right: clamp(2rem, 4vw, 5rem) !important;\n    overflow: visible !important;\n    box-sizing: border-box !important;\n    max-width: 1400px !important;\n    margin-left: auto !important;\n    margin-right: auto !important;\n  }\n  .ltf-section.is-trenches .ltf-split.ltf-split-2 {\n    display: flex !important;\n    flex-direction: row !important;\n    flex-wrap: nowrap !important;\n    align-items: flex-start !important;\n    gap: clamp(20px, 3vw, 40px) !important;\n    width: 100% !important;\n    max-width: 100% !important;\n    overflow: visible !important;\n    box-sizing: border-box !important;\n  }\n  .ltf-section.is-trenches .ltf-section-header-navy,\n  .ltf-section.is-trenches h2 {\n    font-size: clamp(2rem, 4vw, 2.75rem) !important;\n    line-height: 1.08 !important;\n  }\n  .ltf-body-text.is-trenches-body {\n    font-size: clamp(16px, 1.5vw, 18px) !important;\n    line-height: 1.4 !important;\n    padding-right: 0 !important;\n    max-width: 100% !important;\n  }\n  .ltf-stack.ltf-split-copy.is-trenches-copy {\n    flex: 1 1 0 !important;\n    min-width: 0 !important;\n    width: auto !important;\n    max-width: 100% !important;\n    padding-left: 0 !important;\n    padding-right: clamp(12px, 2vw, 28px) !important;\n    box-sizing: border-box !important;\n    overflow: visible !important;\n  }\n  .ltf-section.is-trenches .ltf-authority-image-box.ltf-split-asset {\n    flex: 0 0 auto !important;\n    max-width: min(380px, 42vw) !important;\n    width: auto !important;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .ltf-card:hover::after,\n  .ltf-card.is-glow::after,\n  .ltf-spec-card:hover::after,\n  .ltf-spec-card.is-glow::after,\n  .ltf-upsell-list-item:hover::after,\n  .ltf-upsell-list-item.is-sweep::after {\n    animation: none !important;\n  }\n}\n\n/* Mobile \u2014 keep orange figure inside frame (no sideways scroll) */\n@media (max-width: 991px) {\n  html, body {\n    overflow-x: clip !important;\n    max-width: 100vw !important;\n  }\n\n  /*\n    Hero layout: Webflow Designer only (.ltf-hero, .hero-canvas-wrapper,\n    .ltf-hero-headline, .ltf-hero-bottom-bar, .ltf-hero-figure, combo classes).\n    Do not set position, padding, size, or alignment on hero elements here.\n  */\n  .ltf-funnel-cta-threshold { white-space: nowrap !important; }\n\n\n  /* Trenches fabric \u2014 \u221215% + 50px vertical pad; ~40px from screen edges */\n  .ltf-authority-image-box {\n    width: min(73.1vw, 306px) !important;\n    max-width: calc(100vw - 80px) !important;\n    margin-left: auto !important;\n    margin-right: auto !important;\n    padding-top: 50px !important;\n    padding-bottom: 50px !important;\n  }\n}\n\n/* Specs & Standards \u2014 mobile stack (\u2264767); tablet+ keeps desktop L/R grid + scroll slam */\n@media (max-width: 767px) {\n  .ltf-specs-vault {\n    height: auto !important;\n    min-height: 0 !important;\n  }\n  .ltf-specs-vault-sticky {\n    position: relative !important;\n    height: auto !important;\n    min-height: 0 !important;\n    top: auto !important;\n    padding-top: 75px !important;\n    padding-bottom: 50px !important;\n    padding-left: 25px !important;\n    padding-right: 25px !important;\n    align-items: stretch !important;\n  }\n  .ltf-vault-cage,\n  .ltf-vault-cage.ltf-cage,\n  .ltf-vault-cage.ltf-split-2 {\n    display: flex !important;\n    flex-direction: column !important;\n    width: 100% !important;\n    max-width: 100% !important;\n    padding-top: 0 !important;\n    padding-left: 0 !important;\n    padding-right: 0 !important;\n    gap: 24px !important;\n    align-items: stretch !important;\n  }\n  .ltf-specs-vault-header,\n  .ltf-specs-vault-header.ltf-split-copy {\n    width: 100% !important;\n    max-width: 100% !important;\n    min-width: 0 !important;\n    padding-left: 0 !important;\n    padding-right: 0 !important;\n    padding-bottom: 5px !important;\n    align-items: flex-start !important;\n    align-self: stretch !important;\n    text-align: left !important;\n  }\n  .ltf-specs-vault-header .ltf-section-header-navy,\n  .ltf-specs-vault-header .ltf-subheading-navy,\n  .ltf-specs-vault-header .ltf-body-text-navy {\n    width: 100% !important;\n    max-width: 100% !important;\n    text-align: left !important;\n  }\n  .ltf-specs-vault-header .ltf-subheading-navy {\n    white-space: nowrap !important;\n  }\n  .ltf-specs-vault-cards,\n  .ltf-specs-vault-cards.ltf-split-asset {\n    display: flex !important;\n    flex-direction: column !important;\n    gap: 40px !important;\n    width: 100% !important;\n    max-width: 100% !important;\n    min-height: 0 !important;\n    height: auto !important;\n    padding: 0 !important;\n    overflow: visible !important;\n  }\n  .ltf-spec-card,\n  .ltf-spec-card.ltf-spec-card-01,\n  .ltf-spec-card.ltf-spec-card-02,\n  .ltf-spec-card.ltf-spec-card-03,\n  .ltf-spec-card.ltf-spec-card-04 {\n    position: relative !important;\n    left: auto !important;\n    top: auto !important;\n    right: auto !important;\n    bottom: auto !important;\n    z-index: 1 !important;\n    display: flex !important;\n    flex-direction: column !important;\n    justify-content: flex-start !important;\n    box-sizing: border-box !important;\n    width: 100% !important;\n    max-width: 100% !important;\n    height: auto !important;\n    min-height: 240px !important;\n    max-height: none !important;\n    margin: 0 !important;\n    padding: 24px 16px !important;\n    border-style: solid !important;\n    border-width: 3px !important;\n    border-color: #e5e5e5 !important;\n    border-radius: 12px !important;\n    background-color: #00001C !important;\n    overflow: visible !important;\n    transform: none !important;\n  }\n  .ltf-spec-card .ltf-card-title {\n    font-size: clamp(1.62rem, 2.4vw, 1.98rem) !important;\n  }\n  .ltf-spec-card .ltf-body-text {\n    width: 100% !important;\n    max-width: 100% !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    text-align: left !important;\n    font-size: 18px !important;\n    line-height: 1.35 !important;\n  }\n}\n\n@media (max-width: 991px) {\n  /*\n    Beyond the Gear \u2014 mobile: same 75px H1 section pad as other sections.\n    NO fixed 100vh (was clipping H1 + CTA). List gets 50px top/bottom air.\n  */\n  .ltf-upsell {\n    display: flex !important;\n    flex-direction: column !important;\n    justify-content: flex-start !important;\n    box-sizing: border-box !important;\n    height: auto !important;\n    min-height: 0 !important;\n    padding-top: 75px !important;\n    padding-bottom: 75px !important;\n    padding-left: 0 !important;\n    padding-right: 0 !important;\n    overflow: visible !important;\n  }\n  .ltf-upsell .ltf-upsell-inner.ltf-cage,\n  .ltf-upsell .ltf-upsell-inner {\n    display: flex !important;\n    flex-direction: column !important;\n    justify-content: flex-start !important;\n    width: 100% !important;\n    max-width: 100% !important;\n    padding-left: 25px !important;\n    padding-right: 25px !important;\n    box-sizing: border-box !important;\n    overflow: visible !important;\n  }\n  .ltf-upsell .ltf-section-head,\n  .ltf-upsell .ltf-section-header {\n    margin-top: 0 !important;\n    padding-top: 0 !important;\n  }\n  .ltf-upsell-list {\n    width: 100% !important;\n    max-width: 100% !important;\n    margin-top: 50px !important;\n    margin-bottom: 50px !important;\n  }\n  .ltf-upsell-list-item {\n    display: flex !important;\n    align-items: center !important;\n    font-size: 19.2px !important; /* 24px \u221220% \u2014 fit 2 lines on phone */\n    line-height: 1.22 !important;\n    padding-top: 18px !important;\n    padding-bottom: 18px !important;\n    padding-left: 18px !important;\n    padding-right: 18px !important;\n  }\n  .ltf-upsell-list-item::before {\n    content: '\u25aa' !important;\n    color: #0B8050 !important;\n    display: inline-block !important;\n    font-size: 22px !important;\n    margin-right: 12px !important;\n  }\n  .ltf-upsell-list-item.is-sweep::before,\n  .ltf-upsell-list-item:active::before {\n    color: #7040C0 !important;\n  }\n  .ltf-section-cta.is-beyond-mobile {\n    display: flex !important;\n    width: 100% !important;\n    margin-top: 40px !important;\n    margin-bottom: 20px !important;\n    justify-content: center !important;\n    flex-shrink: 0 !important;\n  }\n}\n</style>\n\n<style id=\"ltf-mobile-fixes\">\n@media (max-width: 991px) {\n  .ltf-hero {\n    height: calc(100svh + 52px) !important;\n    min-height: calc(100svh + 52px) !important;\n    max-height: none !important;\n    overflow-x: clip !important;\n    overflow-y: visible !important;\n  }\n\n  .ltf-hero > .ltf-site-cage.ltf-cage {\n    height: 100% !important;\n    min-height: 100% !important;\n    overflow-x: clip !important;\n    overflow-y: visible !important;\n  }\n\n  .ltf-hero .hero-canvas-wrapper,\n  .ltf-hero #canvas3d {\n    overflow: hidden !important;\n  }\n\n  .ltf-funnel-cta {\n    box-sizing: border-box !important;\n    height: auto !important;\n    min-height: 0 !important;\n    padding-left: 10px !important;\n    padding-right: 10px !important;\n    padding-top: 75px !important;\n    padding-bottom: 75px !important;\n    overflow: visible !important;\n  }\n\n  .ltf-funnel-cta-inner {\n    box-sizing: border-box !important;\n    width: 100% !important;\n    max-width: 100% !important;\n    padding-top: 64px !important;\n    padding-bottom: 64px !important;\n    padding-left: 20px !important;\n    padding-right: 20px !important;\n  }\n\n  .ltf-funnel-cta-heading {\n    padding-left: 0 !important;\n    padding-right: 0 !important;\n    font-size: clamp(2.35rem, 11.5vw, 4.2rem) !important;\n    line-height: 0.92 !important;\n  }\n\n  .ltf-funnel-cta-threshold {\n    white-space: nowrap !important;\n    font-size: clamp(9px,